{% extends 'base.html.twig' %}

{% block title %}Symfony Template Setup{% endblock %}

{% block meta %}
    <meta name="description" content="Get started with your Docker-powered Symfony template: project structure, Doctrine databases, Tailwind assets, and background jobs.">
{% endblock %}

{% block body_class %}min-h-screen bg-slate-950 font-sans text-slate-200 antialiased selection:bg-cyan-500/30{% endblock %}

{% block body %}
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-24">
        <header class="mb-16">
            <h1 class="mb-4 text-4xl font-bold tracking-tight text-white md:text-5xl">
                Welcome to <span class="bg-linear-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">Symfony</span>
            </h1>
            <p class="text-lg leading-relaxed text-slate-400">
                Your environment is ready. Follow this guide to start building.
            </p>
        </header>

        <main class="space-y-12">
            <section aria-labelledby="docker-heading">
                <h2 id="docker-heading" class="mb-6 flex items-center gap-2 text-2xl font-semibold text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-cyan-400" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/>
                    </svg>
                    Docker Compose Required
                </h2>
                <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-sm">
                    <p class="mb-4 text-sm text-slate-400">
                        <strong class="text-slate-300">Crucial:</strong> All application commands must run through Docker Compose. Use PHP, Composer, and NPM inside the container.
                    </p>
                    <div class="space-y-4">
                        <div>
                            <p class="mb-2 text-sm font-medium text-slate-300">Start the dev environment (Nginx serves localhost on port 80):</p>
                            <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose up --build -d</code></pre>
                        </div>
                        <div>
                            <p class="mb-2 text-sm font-medium text-slate-300">Install dependencies, then build the frontend:</p>
                            <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose exec fpm composer install
docker compose exec fpm npm ci
docker compose exec fpm npm run dev</code></pre>
                            <p class="mt-2 text-xs text-slate-400">Composer comes first: Symfony UX frontend packages use files in <code class="text-slate-300">vendor/</code>.</p>
                        </div>
                        <div>
                            <p class="mb-2 text-sm font-medium text-slate-300">Run commands inside the PHP container:</p>
                            <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose exec fpm &lt;command&gt;</code></pre>
                        </div>
                        <div class="border-t border-slate-800 pt-4">
                            <p class="mb-2 text-sm font-medium text-slate-400">Examples:</p>
                            <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-slate-400"><code><span class="text-slate-300"># Add a PHP package</span>
docker compose exec fpm composer require &lt;package&gt;
<span class="text-slate-300"># Add a frontend package</span>
docker compose exec fpm npm install &lt;package&gt;
<span class="text-slate-300"># Generate a controller and Twig template</span>
docker compose exec fpm php bin/console make:controller ExampleController --no-interaction</code></pre>
                        </div>
                        <p class="text-xs leading-relaxed text-slate-400">
                            On Linux, if your UID/GID differs from <code class="text-slate-300">1000:1000</code>, prefix Compose commands with <code class="break-words text-cyan-200">env UID="$(id -u)" GID="$(id -g)"</code>. For automated commands, add <code class="text-slate-300">-T</code> after <code>exec</code>.
                        </p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="structure-heading">
                <h2 id="structure-heading" class="mb-6 flex items-center gap-2 text-2xl font-semibold text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-blue-400" aria-hidden="true">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </svg>
                    Project Structure
                </h2>
                <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-sm">
                    <p class="mb-4 text-sm text-slate-400">
                        The source code is mounted at <code class="rounded bg-slate-800 px-1.5 py-0.5 text-cyan-200">/var/www/html</code>. Host changes sync automatically.
                    </p>
                    <dl class="space-y-4 text-sm">
                        <div class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                            <dt class="shrink-0 font-mono text-blue-300 sm:w-40">src/Controller/</dt>
                            <dd class="min-w-0 text-slate-400">Routes use PHP attributes. <code class="text-slate-300">IndexController.php</code> renders this page.</dd>
                        </div>
                        <div class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                            <dt class="shrink-0 font-mono text-blue-300 sm:w-40">templates/</dt>
                            <dd class="min-w-0 text-slate-400">Twig layouts and pages. Edit <code class="break-words text-slate-300">index/index.html.twig</code> to change this guide.</dd>
                        </div>
                        <div class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                            <dt class="shrink-0 font-mono text-blue-300 sm:w-40">src/Entity/</dt>
                            <dd class="min-w-0 text-slate-400">Doctrine entities, with queries in <code class="text-slate-300">src/Repository/</code> and schema changes in <code class="text-slate-300">migrations/</code>.</dd>
                        </div>
                        <div class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                            <dt class="shrink-0 font-mono text-blue-300 sm:w-40">assets/</dt>
                            <dd class="min-w-0 text-slate-400">JavaScript, Stimulus controllers, and Tailwind styles compiled by Webpack Encore.</dd>
                        </div>
                        <div class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                            <dt class="shrink-0 font-mono text-blue-300 sm:w-40">public/</dt>
                            <dd class="min-w-0 text-slate-400">The web root for static images, fonts, and generated <code class="text-slate-300">build/</code> assets.</dd>
                        </div>
                    </dl>
                    <p class="mt-6 border-t border-slate-800 pt-4 text-sm text-slate-400">
                        The versioned <code class="text-cyan-200">.env</code> contains shared defaults. Put personal settings in Git-ignored <code class="text-cyan-200">.env.local</code>.
                    </p>
                </div>
            </section>

            <section aria-labelledby="database-heading">
                <h2 id="database-heading" class="mb-6 flex items-center gap-2 text-2xl font-semibold text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-amber-400" aria-hidden="true">
                        <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                    </svg>
                    Using a Database (Doctrine ORM)
                </h2>
                <div class="mb-6 space-y-6 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-sm">
                    <div>
                        <h3 class="mb-2 font-medium text-white">1. Choose Your Database &amp; Configure Docker</h3>
                        <p class="mb-3 text-sm text-slate-400">Doctrine ORM and migrations are already installed. The PHP image includes MySQL, PostgreSQL, and SQLite drivers.</p>
                        <h4 class="mb-2 text-sm font-semibold text-orange-400">MySQL (Default in Template)</h4>
                        <p class="mb-3 text-sm text-slate-400">
                            MySQL 9.7.2 is configured in <code class="text-cyan-200">compose.yaml</code>. The <code class="text-cyan-200">.env</code> connection is ready to use:
                        </p>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-amber-300"><code>DATABASE_URL="mysql://app:!ChangeMe!@database:3306/app?serverVersion=9.7.2&amp;charset=utf8mb4"</code></pre>
                        <p class="mt-2 text-xs text-slate-400">Connect from the host at <code class="text-slate-300">localhost:3306</code> using database <code>app</code>, username <code>app</code>, and password <code>!ChangeMe!</code>.</p>

                        <div class="mt-4 border-t border-slate-800 pt-4">
                            <p class="mb-4 text-sm text-slate-400">To switch databases, update <code class="text-cyan-200">compose.yaml</code> and <code class="text-cyan-200">DATABASE_URL</code>. These examples use <code class="text-cyan-200">.env.local</code> for a personal override.</p>
                            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                                <div class="min-w-0 space-y-2">
                                    <h4 class="text-sm font-semibold text-blue-400">PostgreSQL</h4>
                                    <p class="text-xs text-slate-400">Replace the MySQL <code>database</code> service, including its health check:</p>
                                    <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-amber-300"><code># compose.yaml: services.database
database:
  image: postgres:16
  environment:
    POSTGRES_USER: app
    POSTGRES_PASSWORD: "!ChangeMe!"
    POSTGRES_DB: app
  ports:
    - "5432:5432"
  healthcheck:
    test: ["CMD-SHELL", "pg_isready -U app -d app"]
    interval: 5s
    timeout: 3s
    retries: 5</code></pre>
                                    <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-amber-300"><code># .env.local
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&amp;charset=utf8"</code></pre>
                                </div>
                                <div class="min-w-0 space-y-2">
                                    <h4 class="text-sm font-semibold text-slate-300">SQLite</h4>
                                    <p class="text-xs leading-relaxed text-slate-400">Remove the <code>database</code> service and the <code>fpm.depends_on</code> entry. Store the database in the mounted project directory:</p>
                                    <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-amber-300"><code># .env.local
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_dev.db"</code></pre>
                                    <p class="text-xs leading-relaxed text-slate-400">The existing source mount preserves the database file on your host. Files in <code>var/</code> are Git-ignored.</p>
                                </div>
                            </div>
                            <p class="mt-3 text-xs text-slate-400">After changing Compose services, run <code class="text-cyan-200">docker compose up --build -d</code>.</p>
                        </div>
                    </div>
                    <div>
                        <h3 class="mb-2 font-medium text-white">2. Define Your Entities</h3>
                        <p class="mb-3 text-sm text-slate-400">Use MakerBundle to create an entity and follow the prompts to add fields:</p>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose exec fpm php bin/console make:entity</code></pre>
                    </div>
                    <div>
                        <h3 class="mb-2 font-medium text-white">3. Generate &amp; Apply Migrations</h3>
                        <p class="mb-3 text-sm text-slate-400">Review the generated migration in <code class="text-cyan-200">migrations/</code>, then apply it:</p>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-cyan-300"><code>docker compose exec fpm php bin/console make:migration --no-interaction
docker compose exec fpm php bin/console doctrine:migrations:migrate --no-interaction</code></pre>
                        <div class="mt-4 rounded-lg border border-purple-900/50 p-4">
                            <p class="text-sm leading-relaxed text-slate-300">
                                <strong class="font-semibold text-purple-400">Explicit migrations:</strong> Apply schema changes through migrations, including after pulling new ones. Container startup does not run migrations automatically.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <a href="https://symfony.com/doc/8.1/doctrine.html" target="_blank" rel="noopener noreferrer" class="group rounded-xl border border-slate-800 bg-slate-900 p-4 transition-colors hover:border-amber-500/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400">
                        <h3 class="mb-1 font-medium text-white transition-colors group-hover:text-amber-400">Doctrine ORM Docs &rarr;</h3>
                        <p class="text-sm text-slate-400">Entities, repositories, queries, and migrations.</p>
                    </a>
                </div>
            </section>

            <section aria-labelledby="assets-heading">
                <h2 id="assets-heading" class="mb-6 flex items-center gap-2 text-2xl font-semibold text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-pink-400" aria-hidden="true">
                        <path d="m16 18 6-6-6-6M8 6l-6 6 6 6m6-14-4 16"/>
                    </svg>
                    Frontend Assets (Tailwind &amp; Symfony UX)
                </h2>
                <div class="space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-sm">
                    <p class="text-sm leading-relaxed text-slate-400">
                        Tailwind CSS 4 is configured through PostCSS in <code class="text-cyan-200">assets/styles/app.css</code>. Webpack Encore compiles your assets, and Symfony UX provides Stimulus and Turbo.
                    </p>
                    <div>
                        <h3 class="mb-2 font-medium text-white">Watch for Changes</h3>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose exec fpm npm run watch</code></pre>
                        <p class="mt-2 text-sm text-slate-400">Keep this running in a separate terminal, then refresh your browser after changes to assets or Tailwind classes. PHP and Twig edits are available on the next request.</p>
                    </div>
                    <div class="border-t border-slate-800 pt-4">
                        <h3 class="mb-2 font-medium text-white">Build for Production</h3>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose exec fpm npm run build</code></pre>
                        <p class="mt-2 text-xs text-slate-400">Optimized, versioned files are written to <code class="text-slate-300">public/build/</code>. Edit source files in <code class="text-slate-300">assets/</code>.</p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="jobs-heading">
                <h2 id="jobs-heading" class="mb-6 flex items-center gap-2 text-2xl font-semibold text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-emerald-400" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                    </svg>
                    Background Jobs (Messenger)
                </h2>
                <div class="space-y-4 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-sm">
                    <p class="text-sm text-slate-400">Messenger handles queued work using Doctrine-backed <code class="text-cyan-200">async</code> and <code class="text-cyan-200">failed</code> transports.</p>
                    <div>
                        <h3 class="mb-2 font-medium text-white">1. Prepare the Queue Tables</h3>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-emerald-300"><code>docker compose exec fpm php bin/console messenger:setup-transports</code></pre>
                        <p class="mt-2 text-xs text-slate-400">Run this before dispatching messages: the default DSN disables automatic table creation.</p>
                    </div>
                    <div class="border-t border-slate-800 pt-4">
                        <h3 class="mb-2 font-medium text-white">2. Create a Message &amp; Handler</h3>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-emerald-300"><code>docker compose exec fpm php bin/console make:message ExampleMessage --no-interaction</code></pre>
                        <p class="mt-2 text-sm text-slate-400">Route your message in <code class="text-cyan-200">config/packages/messenger.yaml</code>:</p>
                        <pre class="mt-3 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-amber-300"><code>framework:
    messenger:
        routing:
            'App\Message\ExampleMessage': async</code></pre>
                        <p class="mt-2 text-sm text-slate-400">Add work to the generated handler and dispatch the message with <code class="text-cyan-200">MessageBusInterface</code>.</p>
                    </div>
                    <div class="border-t border-slate-800 pt-4">
                        <h3 class="mb-2 font-medium text-white">3. Run a Worker</h3>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose exec fpm php bin/console messenger:consume async -vv</code></pre>
                        <p class="mt-2 text-sm text-slate-400">The worker runs in the foreground and displays job output. Keep it running in a separate terminal; Ctrl+C stops it. Compose does not start workers automatically.</p>
                    </div>
                    <div class="border-t border-slate-800 pt-4">
                        <h3 class="mb-2 font-medium text-white">Development Email with Mailpit</h3>
                        <p class="mb-3 text-sm text-slate-400">Mailpit is provided by <code class="text-cyan-200">compose.override.yaml</code>. Set this in <code class="text-cyan-200">.env.local</code> and keep the worker running for queued emails:</p>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-xs text-amber-300"><code>MAILER_DSN=smtp://mailer:1025</code></pre>
                        <p class="my-3 text-sm text-slate-400">Find the web UI port, then open <code class="text-cyan-200">http://localhost:&lt;port&gt;</code>:</p>
                        <pre class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-cyan-300"><code>docker compose port mailer 8025</code></pre>
                        <p class="mt-2 text-xs text-slate-400">Email, chat, and SMS messages are already queued. The default <code>null://null</code> mailer discards emails.</p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="docs-heading">
                <h2 id="docs-heading" class="mb-6 flex items-center gap-2 text-2xl font-semibold text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-purple-400" aria-hidden="true">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                    Symfony Documentation
                </h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    {% for guide in [
                        {title: 'Routing & Controllers', url: 'https://symfony.com/doc/8.1/routing.html', description: 'PHP route attributes, parameters, and URL generation.'},
                        {title: 'Twig Templates', url: 'https://symfony.com/doc/8.1/templates.html', description: 'Layouts, reusable fragments, and rendering pages.'},
                        {title: 'Symfony UX', url: 'https://symfony.com/bundles/StimulusBundle/current/index.html', description: 'Interactive interfaces with Stimulus controllers.'},
                        {title: 'Styling & Tailwind', url: 'https://tailwindcss.com/docs/installation/using-postcss', description: 'Utility classes and the Tailwind CSS PostCSS setup.'},
                        {title: 'Forms & Validation', url: 'https://symfony.com/doc/8.1/forms.html', description: 'Build forms, bind data, and validate user input.'},
                        {title: 'Messenger', url: 'https://symfony.com/doc/8.1/messenger.html', description: 'Message handlers, transports, retries, and workers.'}
                    ] %}
                        <a href="{{ guide.url }}" target="_blank" rel="noopener noreferrer" class="group rounded-xl border border-slate-800 bg-slate-900 p-4 transition-colors hover:border-purple-500/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400">
                            <h3 class="mb-1 font-medium text-white transition-colors group-hover:text-purple-400">{{ guide.title }} &rarr;</h3>
                            <p class="text-sm text-slate-400">{{ guide.description }}</p>
                        </a>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>
{% endblock %}
